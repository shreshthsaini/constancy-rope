\@writefile{lof}{\contentsline {figure}{\numberline {C.1}{\ignorespaces \textbf  {The temperature carries the gain.} Paired held-out contrasts (rows 8 to 194, seed 0, $n=187$) of the RoPE base and the global temperature as main effects, their interaction, and the allocation (SEGA (released){} minus SEGA base\,+\,temp.\spacefactor \@m {}). Whiskers are nominal 95\% intervals, and marks are pale where the interval covers zero. \Cref  {tab:strengthen-factorial} gives the values.\relax }}{21}{figure.caption.52}\protected@file@percent }
\newlabel{fig:fs-factorial}{{C.1}{21}{\textbf {The temperature carries the gain.} Paired held-out contrasts (rows 8 to 194, seed 0, $n=\N {st@f@n}$) of the RoPE base and the global temperature as main effects, their interaction, and the allocation (\segaofficial {} minus \tempsb ). Whiskers are nominal 95\% intervals, and marks are pale where the interval covers zero. \Cref {tab:strengthen-factorial} gives the values.\relax }{figure.caption.52}{}}
\newlabel{fig:fs-factorial@cref}{{[figure][1][2147483647,3]C.1}{[1][21][]21}}
\@writefile{lof}{\contentsline {figure}{\numberline {C.2}{\ignorespaces \textbf  {Temperature sweep.} SEGA base\,+\,temp.\spacefactor \@m {}{} at five logit multipliers fixed before generation, minus the reference $s^{0.16}$ (hollow mark, dashed vertical), on held-out rows 8 to 62 ($n=55$, seed 0). Whiskers are nominal 95\% paired intervals; pale marks cover zero. Reward models and full-frame MUSIQ fall on both sides of $s^{0.16}$, while crop MUSIQ keeps rising with the multiplier.\relax }}{21}{figure.caption.56}\protected@file@percent }
\newlabel{fig:fs-sweep}{{C.2}{21}{\textbf {Temperature sweep.} \tempsb {} at five logit multipliers fixed before generation, minus the reference $s^{0.16}$ (hollow mark, dashed vertical), on held-out rows 8 to 62 ($n=\N {st@s@n}$, seed 0). Whiskers are nominal 95\% paired intervals; pale marks cover zero. Reward models and full-frame MUSIQ fall on both sides of $s^{0.16}$, while crop MUSIQ keeps rising with the multiplier.\relax }{figure.caption.56}{}}
\newlabel{fig:fs-sweep@cref}{{[figure][2][2147483647,3]C.2}{[1][21][]21}}
\@writefile{lot}{\contentsline {table}{\numberline {C.1}{\ignorespaces \textbf  {All factorial contrasts.} Every registered contrast and metric of the held-out factorial ($n=187$, seed 0), with the same cells, marks and Holm family as \cref  {tab:strengthen-factorial}, transposed; bold marks the largest gain for each metric. Key result: 31 of 80 tests survive Holm: 27 temperature tests (every metric except tiling) and 4 allocation tests (better on full-frame MUSIQ, crop CLIP-IQA and slope error; worse on tiling); neither the RoPE base nor the interaction survives Holm on any of the ten metrics.\relax }}{22}{table.caption.53}\protected@file@percent }
\newlabel{tab:strengthen-factorial-full}{{C.1}{22}{\textbf {All factorial contrasts.} Every registered contrast and metric of the held-out factorial ($n=187$, seed 0), with the same cells, marks and Holm family as \cref {tab:strengthen-factorial}, transposed; bold marks the largest gain for each metric. Key result: 31 of 80 tests survive Holm: 27 temperature tests (every metric except tiling) and 4 allocation tests (better on full-frame MUSIQ, crop CLIP-IQA and slope error; worse on tiling); neither the RoPE base nor the interaction survives Holm on any of the ten metrics.\relax }{table.caption.53}{}}
\newlabel{tab:strengthen-factorial-full@cref}{{[table][1][2147483647,3]C.1}{[1][21][]22}}
\@writefile{lot}{\contentsline {table}{\numberline {C.2}{\ignorespaces \textbf  {Factorial cell means.} Held-out means ($n=187$, seed 0) of the four base-by-temperature cells and of SEGA (released){}, in the shaded column; the first two columns have no temperature. Bold is best and underlined second for each metric among the displayed rounded values; the paired tests are in \cref  {tab:strengthen-factorial}. Key result: each of the three arms with the temperature scores better than both arms without it on every metric except slope error.\relax }}{22}{table.caption.54}\protected@file@percent }
\newlabel{tab:strengthen-factorial-means}{{C.2}{22}{\textbf {Factorial cell means.} Held-out means ($n=187$, seed 0) of the four base-by-temperature cells and of \segaofficial {}, in the shaded column; the first two columns have no temperature. Bold is best and underlined second for each metric among the displayed rounded values; the paired tests are in \cref {tab:strengthen-factorial}. Key result: each of the three arms with the temperature scores better than both arms without it on every metric except slope error.\relax }{table.caption.54}{}}
\newlabel{tab:strengthen-factorial-means@cref}{{[table][2][2147483647,3]C.2}{[1][21][]22}}
\@writefile{lot}{\contentsline {table}{\numberline {C.3}{\ignorespaces \textbf  {Global temperature sweep.} SEGA base\,+\,temp.\spacefactor \@m {}{} with the logit multiplier fixed in advance at five values, held-out rows 8 to 62 ($n=55$, seed 0, the first 55 held-out rows of the manifest). The shaded column is SEGA's reference $s^{0.16}=1.248$ and shows means; other columns show the paired difference from it with nominal 95\% intervals; $^{*}$ marks Holm-adjusted $p\le 0.05$ over 40 tests (4 settings by 10 metrics). Bold marks the best setting for a metric when its interval separates it from the reference. No value was selected from these results. Key result: removing the temperature (1.000) worsens all six displayed metrics under Holm (ImageReward $-0.671$); no multiplier beats $s^{0.16}$ under Holm on ImageReward, PickScore or full-frame MUSIQ, whereas crop MUSIQ rises monotonically with the multiplier, from 40.12 at 1.000 to 65.87 at 1.450.\relax }}{23}{table.caption.55}\protected@file@percent }
\newlabel{tab:strengthen-sweep}{{C.3}{23}{\textbf {Global temperature sweep.} \tempsb {} with the logit multiplier fixed in advance at five values, held-out rows 8 to 62 ($n=55$, seed 0, the first 55 held-out rows of the manifest). The shaded column is \sega 's reference $s^{0.16}=1.248$ and shows means; other columns show the paired difference from it with nominal 95\% intervals; $^{*}$ marks Holm-adjusted $p\le 0.05$ over 40 tests (4 settings by 10 metrics). Bold marks the best setting for a metric when its interval separates it from the reference. No value was selected from these results. Key result: removing the temperature (1.000) worsens all six displayed metrics under Holm (ImageReward $-0.671$); no multiplier beats $s^{0.16}$ under Holm on ImageReward, PickScore or full-frame MUSIQ, whereas crop MUSIQ rises monotonically with the multiplier, from 40.12 at 1.000 to 65.87 at 1.450.\relax }{table.caption.55}{}}
\newlabel{tab:strengthen-sweep@cref}{{[table][3][2147483647,3]C.3}{[1][21][]23}}
\@writefile{lof}{\contentsline {figure}{\numberline {C.3}{\ignorespaces \textbf  {Registered confirmation, all three panels.} ImageReward and PickScore show SEGA base\,+\,temp.\spacefactor \@m {}{} minus SEGA (released){} with the amended equivalence margins (gray band, dotted edges); full-frame MUSIQ shows the opposite difference, SEGA (released){} minus SEGA base\,+\,temp.\spacefactor \@m {}, the effect of the allocation. Filled marks are the registered tests (H1 on the 337 pooled prompts, H2 on the 150 fresh prompts); hollow marks are the fresh prompts alone, the 187 held-out prompts at seed 0 and their means over seeds 0 to 2. Whiskers are nominal 95\% paired prompt-bootstrap intervals (2{,}000 draws); \cref  {tab:strengthen-fresh-tests} lists the values and Holm-adjusted $p$.\relax }}{23}{figure.caption.57}\protected@file@percent }
\newlabel{fig:fs-confirm-full}{{C.3}{23}{\textbf {Registered confirmation, all three panels.} ImageReward and PickScore show \tempsb {} minus \segaofficial {} with the amended equivalence margins (gray band, dotted edges); full-frame MUSIQ shows the opposite difference, \segaofficial {} minus \tempsb , the effect of the allocation. Filled marks are the registered tests (H1 on the \N {st@h@n@ir} pooled prompts, H2 on the \N {st@e@n} fresh prompts); hollow marks are the fresh prompts alone, the \N {st@f@n} held-out prompts at seed 0 and their means over seeds 0 to 2. Whiskers are nominal 95\% paired prompt-bootstrap intervals (2{,}000 draws); \cref {tab:strengthen-fresh-tests} lists the values and Holm-adjusted $p$.\relax }{figure.caption.57}{}}
\newlabel{fig:fs-confirm-full@cref}{{[figure][3][2147483647,3]C.3}{[1][21][]23}}
\@writefile{lot}{\contentsline {table}{\numberline {C.4}{\ignorespaces \textbf  {Registered confirmation.} $\Delta $ is SEGA base\,+\,temp.\spacefactor \@m {}{} minus SEGA (released){} for H1 and the reverse for H2. H1 pools the 187 held-out prompts, inspected before registration, and 150 fresh prompts (seed 0) and needs both nominal intervals inside the margins and both Holm-adjusted equivalence $p\le 0.05$; H2 uses the fresh prompts only and needs a positive lower bound and Holm $p\le 0.05$. Holm runs over the three registered tests. The lower rows apply the same rules to the fresh prompts alone and to held-out prompt means over seeds 0 to 2, each with its own Holm family; they describe, but do not decide, the hypotheses. \Cref  {tab:strengthen-fresh-arms,tab:strengthen-seeds} expand this table. Key result: H1 is supported on the pooled prompts and H2 is supported; on the fresh prompts alone the PickScore interval crosses the $-0.10$ margin, so equivalence is not established there.\relax }}{24}{table.caption.58}\protected@file@percent }
\newlabel{tab:strengthen-fresh-tests}{{C.4}{24}{\textbf {Registered confirmation.} $\Delta $ is \tempsb {} minus \segaofficial {} for H1 and the reverse for H2. H1 pools the 187 held-out prompts, inspected before registration, and 150 fresh prompts (seed 0) and needs both nominal intervals inside the margins and both Holm-adjusted equivalence $p\le 0.05$; H2 uses the fresh prompts only and needs a positive lower bound and Holm $p\le 0.05$. Holm runs over the three registered tests. The lower rows apply the same rules to the fresh prompts alone and to held-out prompt means over seeds 0 to 2, each with its own Holm family; they describe, but do not decide, the hypotheses. \Cref {tab:strengthen-fresh-arms,tab:strengthen-seeds} expand this table. Key result: H1 is supported on the pooled prompts and H2 is supported; on the fresh prompts alone the PickScore interval crosses the $-0.10$ margin, so equivalence is not established there.\relax }{table.caption.58}{}}
\newlabel{tab:strengthen-fresh-tests@cref}{{[table][4][2147483647,3]C.4}{[1][21][]24}}
\@writefile{lot}{\contentsline {table}{\numberline {C.5}{\ignorespaces \textbf  {Fresh prompts.} Means of SEGA (released){}, in the shaded column, and paired differences from it on 150 unseen Aesthetic-4K training captions ($n=150$, seed 0), with nominal 95\% intervals; $^{*}$ marks Holm-adjusted $p\le 0.05$ over 50 tests (5 arms by 10 metrics). Bold marks the best entry for a metric when its interval separates it from SEGA (released). Key result: DyPE{} is the only arm that beats SEGA (released){} under Holm on crop MUSIQ ($+2.32$) and CLIP-IQA ($+0.024$) while losing ImageReward ($-0.166$) and PickScore ($-0.38$); SEGA base\,+\,temp.\spacefactor \@m {}{} ties ImageReward ($-0.011$) and loses crop CLIP-IQA and slope error under Holm.\relax }}{24}{table.caption.59}\protected@file@percent }
\newlabel{tab:strengthen-fresh-arms}{{C.5}{24}{\textbf {Fresh prompts.} Means of \segaofficial {}, in the shaded column, and paired differences from it on 150 unseen Aesthetic-4K training captions ($n=150$, seed 0), with nominal 95\% intervals; $^{*}$ marks Holm-adjusted $p\le 0.05$ over 50 tests (5 arms by 10 metrics). Bold marks the best entry for a metric when its interval separates it from \segaofficial . Key result: \dype {} is the only arm that beats \segaofficial {} under Holm on crop MUSIQ ($+2.32$) and CLIP-IQA ($+0.024$) while losing ImageReward ($-0.166$) and PickScore ($-0.38$); \tempsb {} ties ImageReward ($-0.011$) and loses crop CLIP-IQA and slope error under Holm.\relax }{table.caption.59}{}}
\newlabel{tab:strengthen-fresh-arms@cref}{{[table][5][2147483647,3]C.5}{[1][21][]24}}
\@writefile{lot}{\contentsline {table}{\numberline {C.6}{\ignorespaces \textbf  {Seed replication.} Held-out rows 8 to 194 ($n=187$ prompts): SEGA (released){} means over seeds 0 to 2 (shaded column) and paired differences of SEGA base\,+\,temp.\spacefactor \@m {}{} minus SEGA (released). The first difference column averages seeds 0, 1 and 2 within each prompt before the paired bootstrap; $^{*}$ marks Holm-adjusted $p\le 0.05$ over its 10 metrics and bold marks the better arm where its interval excludes zero. The other columns are sensitivity analyses without Holm marks. Key result: averaged over seeds, SEGA base\,+\,temp.\spacefactor \@m {}{} minus SEGA (released){} is $+0.021$ [$-0.004$, $+0.044$] on ImageReward and $-0.000$ [$-0.035$, $+0.037$] on PickScore, and $-2.00$ [$-2.74$, $-1.30$] on full-frame MUSIQ (Holm); every single seed gives the same MUSIQ verdict.\relax }}{25}{table.caption.60}\protected@file@percent }
\newlabel{tab:strengthen-seeds}{{C.6}{25}{\textbf {Seed replication.} Held-out rows 8 to 194 ($n=187$ prompts): \segaofficial {} means over seeds 0 to 2 (shaded column) and paired differences of \tempsb {} minus \segaofficial . The first difference column averages seeds 0, 1 and 2 within each prompt before the paired bootstrap; $^{*}$ marks Holm-adjusted $p\le 0.05$ over its 10 metrics and bold marks the better arm where its interval excludes zero. The other columns are sensitivity analyses without Holm marks. Key result: averaged over seeds, \tempsb {} minus \segaofficial {} is $+0.021$ [$-0.004$, $+0.044$] on ImageReward and $-0.000$ [$-0.035$, $+0.037$] on PickScore, and $-2.00$ [$-2.74$, $-1.30$] on full-frame MUSIQ (Holm); every single seed gives the same MUSIQ verdict.\relax }{table.caption.60}{}}
\newlabel{tab:strengthen-seeds@cref}{{[table][6][2147483647,3]C.6}{[1][21][]25}}
\@writefile{lot}{\contentsline {table}{\numberline {C.7}{\ignorespaces \textbf  {Checkpoint by guidance.} Official DyPE{} code on development rows 0 to 7 (seed 42, 28 steps, $4096^2$). Each entry is a ratio of whitened luminance power (radial power times $f^2$, Hann window) at one lattice bin with a period of 8 to 64 pixels: geometric mean over the 8 prompts with a 95\% bootstrap interval on the logs. The historical statistic picks the bin on the FLUX.1-dev{} image and is biased upward; the shared bin is picked once per prompt from the mean log spectrum of all four cells. Descriptive development evidence, not a held-out test. Key result: FLUX.1-dev{} carries more lattice power than FLUX.1-Krea-dev{} at both matched guidance values; raising guidance from 3.5 to 4.5 lowers it on FLUX.1-dev{} while the FLUX.1-Krea-dev{} interval covers 1, so guidance modulates the lattice but does not create the checkpoint gap.\relax }}{25}{table.caption.61}\protected@file@percent }
\newlabel{tab:strengthen-ckpt}{{C.7}{25}{\textbf {Checkpoint by guidance.} Official \dype {} code on development rows 0 to 7 (seed 42, 28 steps, $4096^2$). Each entry is a ratio of whitened luminance power (radial power times $f^2$, Hann window) at one lattice bin with a period of 8 to 64 pixels: geometric mean over the 8 prompts with a 95\% bootstrap interval on the logs. The historical statistic picks the bin on the \fluxdev {} image and is biased upward; the shared bin is picked once per prompt from the mean log spectrum of all four cells. Descriptive development evidence, not a held-out test. Key result: \fluxdev {} carries more lattice power than \krea {} at both matched guidance values; raising guidance from 3.5 to 4.5 lowers it on \fluxdev {} while the \krea {} interval covers 1, so guidance modulates the lattice but does not create the checkpoint gap.\relax }{table.caption.61}{}}
\newlabel{tab:strengthen-ckpt@cref}{{[table][7][2147483647,3]C.7}{[1][21][]25}}
\@writefile{lot}{\contentsline {table}{\numberline {C.8}{\ignorespaces \textbf  {Default flow shift.} SEGA (released){} on development rows 0 to 7 (seed 0, 28 steps, guidance 4.5, $4096^2$) with the official shift ($\mu =1.15$, shaded) and with the diffusers default, which extrapolates $\mu $ to 11.55 at 65{,}536 image tokens. Means over 8 prompts, bold best; the last column is the paired difference with a nominal 95\% interval. Descriptive development evidence. Key result: the default shift worsens all ten metrics and lowers ImageReward by 3.70 [3.42, 3.96].\relax }}{26}{table.caption.62}\protected@file@percent }
\newlabel{tab:strengthen-default-shift}{{C.8}{26}{\textbf {Default flow shift.} \segaofficial {} on development rows 0 to 7 (seed 0, 28 steps, guidance 4.5, $4096^2$) with the official shift ($\mu =1.15$, shaded) and with the diffusers default, which extrapolates $\mu $ to 11.55 at 65{,}536 image tokens. Means over 8 prompts, bold best; the last column is the paired difference with a nominal 95\% interval. Descriptive development evidence. Key result: the default shift worsens all ten metrics and lowers ImageReward by 3.70 [3.42, 3.96].\relax }{table.caption.62}{}}
\newlabel{tab:strengthen-default-shift@cref}{{[table][8][2147483647,3]C.8}{[1][21][]26}}
