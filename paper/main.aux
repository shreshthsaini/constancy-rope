\@writefile{lot}{\contentsline {table}{\numberline {B.1}{\ignorespaces \textbf  {Paired held-out differences (expands \cref  {tab:results}).} Held-out paired differences against SEGA (released){} (rows 8--194, seed 0, $n=187$); the first row gives the absolute means of SEGA (released). Each cell shows the mean difference and its nominal 95\% bootstrap interval; \leavevmode {\color  {betterc}\scalebox {0.7}{$\blacktriangle $}}{}/\leavevmode {\color  {worsec}\scalebox {0.7}{$\blacktriangledown $}}{} mark intervals that exclude zero in the better or worse direction; unmarked cells are ties. A star marks a Holm-adjusted $p\le 0.05$ across this table's paired comparisons, using approximate centered-bootstrap tests. \Cref  {tab:deltas_full} has all ten metrics and a separate Holm family. Key result: base and temperature carry most of SEGA's gain, and no per-band law beats it.\relax }}{19}{table.caption.47}\protected@file@percent }
\newlabel{tab:main}{{B.1}{19}{\textbf {Paired held-out differences (expands \cref {tab:results}).} Held-out paired differences against \segaofficial {} (rows 8--194, seed 0, $n=\N {ho@nprompts}$); the first row gives the absolute means of \segaofficial . Each cell shows the mean difference and its nominal 95\% bootstrap interval; \better {}/\worse {} mark intervals that exclude zero in the better or worse direction; unmarked cells are ties. A star marks a Holm-adjusted $p\le 0.05$ across this table's paired comparisons, using approximate centered-bootstrap tests. \Cref {tab:deltas_full} has all ten metrics and a separate Holm family. Key result: base and temperature carry most of \sega 's gain, and no per-band law beats it.\relax }{table.caption.47}{}}
\newlabel{tab:main@cref}{{[table][1][2147483647,2]B.1}{[1][19][]19}}
\@writefile{lot}{\contentsline {table}{\numberline {B.2}{\ignorespaces \textbf  {Where SEGA's improvement over NTK{} comes from.} Means on the same 187 held-out prompts, paired gains from base and temperature and from the allocation, and the share of the total gain carried by base and temperature, (SEGA base\,+\,temp.\spacefactor \@m {}{} $-$ NTK)/(SEGA (released){} $-$ NTK), with its 95\% paired bootstrap interval. A share above 100\% means the allocation's point estimate is negative.\relax }}{19}{table.caption.48}\protected@file@percent }
\newlabel{tab:share}{{B.2}{19}{\textbf {Where \sega 's improvement over \ntk {} comes from.} Means on the same \N {sh@n} held-out prompts, paired gains from base and temperature and from the allocation, and the share of the total gain carried by base and temperature, (\tempsb {} $-$ \ntk )/(\segaofficial {} $-$ \ntk ), with its 95\% paired bootstrap interval. A share above 100\% means the allocation's point estimate is negative.\relax }{table.caption.48}{}}
\newlabel{tab:share@cref}{{[table][2][2147483647,2]B.2}{[1][19][]19}}
\@writefile{lot}{\contentsline {table}{\numberline {B.3}{\ignorespaces \textbf  {Held-out means with 95\% bootstrap intervals} (rows 8--194, seed 0). Constancy{} is the partial run on 41 prompts (\cref  {app:partial}).\relax }}{20}{table.caption.49}\protected@file@percent }
\newlabel{tab:means_full}{{B.3}{20}{\textbf {Held-out means with 95\% bootstrap intervals} (rows 8--194, seed 0). \constancy {} is the partial run on \hon {cons} prompts (\cref {app:partial}).\relax }{table.caption.49}{}}
\newlabel{tab:means_full@cref}{{[table][3][2147483647,2]B.3}{[1][19][]20}}
\@writefile{lot}{\contentsline {table}{\numberline {B.4}{\ignorespaces \textbf  {Held-out paired differences against SEGA (released){}, all metrics.} Nominal 95\% intervals and direction triangles as in \cref  {tab:main}; stars mark approximate Holm-adjusted $p\le 0.05$ across all paired comparisons in this table. Constancy{} is the partial run on 41 prompts (\cref  {app:partial}).\relax }}{20}{table.caption.50}\protected@file@percent }
\newlabel{tab:deltas_full}{{B.4}{20}{\textbf {Held-out paired differences against \segaofficial {}, all metrics.} Nominal 95\% intervals and direction triangles as in \cref {tab:main}; stars mark approximate Holm-adjusted $p\le 0.05$ across all paired comparisons in this table. \constancy {} is the partial run on \hon {cons} prompts (\cref {app:partial}).\relax }{table.caption.50}{}}
