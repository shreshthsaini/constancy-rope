\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Factorial decomposition of SEGA (released).} Paired held-out contrasts (rows 8 to 194, $n=187$, seed 0) of a 2$\times $2 design, RoPE base (NTK{} or SEGA) by logit temperature (none or $s^{0.16}$), plus the allocation (SEGA (released){} minus SEGA base\,+\,temp.\spacefactor \@m {}). Main effects average over the other factor; the interaction is the temperature effect on the SEGA{} base minus that on the NTK{} base. Base, temperature and allocation sum exactly to the total, SEGA (released){} minus NTK, whose interval is computed directly; it is not a registered test. Cells give paired mean differences and nominal 95\% intervals; triangles mark intervals that exclude zero, $^{*}$ a Holm-adjusted $p\le 0.05$ over the 80 registered tests, and bold the largest effect per column. \Cref  {tab:strengthen-factorial-full} expands the table. Key result: the global temperature improves all six displayed metrics under Holm, neither the RoPE base nor the interaction survives Holm on any of the ten metrics, and the allocation improves full-frame MUSIQ ($+2.09$) while tying ImageReward and PickScore.\relax }}{6}{table.caption.20}\protected@file@percent }
\newlabel{tab:strengthen-factorial}{{3}{6}{\textbf {Factorial decomposition of \segaofficial .} Paired held-out contrasts (rows 8 to 194, $n=187$, seed 0) of a 2$\times $2 design, RoPE base (\ntk {} or \sega ) by logit temperature (none or $s^{0.16}$), plus the allocation (\segaofficial {} minus \tempsb ). Main effects average over the other factor; the interaction is the temperature effect on the \sega {} base minus that on the \ntk {} base. Base, temperature and allocation sum exactly to the total, \segaofficial {} minus \ntk , whose interval is computed directly; it is not a registered test. Cells give paired mean differences and nominal 95\% intervals; triangles mark intervals that exclude zero, $^{*}$ a Holm-adjusted $p\le 0.05$ over the 80 registered tests, and bold the largest effect per column. \Cref {tab:strengthen-factorial-full} expands the table. Key result: the global temperature improves all six displayed metrics under Holm, neither the RoPE base nor the interaction survives Holm on any of the ten metrics, and the allocation improves full-frame MUSIQ ($+2.09$) while tying ImageReward and PickScore.\relax }{table.caption.20}{}}
\newlabel{tab:strengthen-factorial@cref}{{[table][3][]3}{[1][6][]6}}
