\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Held-out results and decomposition.} Means over rows 8--194 (seed 0, $n=187$); bold marks the best mean and underline the second, which alone imply no significant difference. \leavevmode {\color  {betterc}\scalebox {0.7}{$\blacktriangle $}}/\leavevmode {\color  {worsec}\scalebox {0.7}{$\blacktriangledown $}}{} mark paired 95\% intervals against SEGA (released){} (shaded) that exclude zero, and $^{*}$ a Holm-adjusted $p\le 0.05$; DyPE{} (gray) is context. The bottom block gives paired gains (base\,+\,temp.: SEGA base\,+\,temp.\spacefactor \@m {}{} $-$ NTK; allocation: SEGA (released){} $-$ SEGA base\,+\,temp.\spacefactor \@m {}), which \cref  {tab:strengthen-factorial} splits further; \cref  {tab:main,tab:share,tab:means_full,tab:deltas_full} expand this table. Key result: SEGA base\,+\,temp.\spacefactor \@m {}{} ties SEGA (released){} on all three reward models and crop MUSIQ, and the allocation adds only full-frame MUSIQ and CLIP-IQA.\relax }}{5}{table.caption.11}\protected@file@percent }
\newlabel{tab:results}{{2}{5}{\textbf {Held-out results and decomposition.} Means over rows 8--194 (seed 0, $n=\N {ho@nprompts}$); bold marks the best mean and underline the second, which alone imply no significant difference. \better /\worse {} mark paired 95\% intervals against \segaofficial {} (shaded) that exclude zero, and $^{*}$ a Holm-adjusted $p\le 0.05$; \dype {} (gray) is context. The bottom block gives paired gains (base\,+\,temp.: \tempsb {} $-$ \ntk ; allocation: \segaofficial {} $-$ \tempsb ), which \cref {tab:strengthen-factorial} splits further; \cref {tab:main,tab:share,tab:means_full,tab:deltas_full} expand this table. Key result: \tempsb {} ties \segaofficial {} on all three reward models and crop MUSIQ, and the allocation adds only full-frame MUSIQ and CLIP-IQA.\relax }{table.caption.11}{}}
\newlabel{tab:results@cref}{{[table][2][]2}{[1][4][]5}}
