\newlabel{app:figs@cref}{{[appendix][1][2147483647]A}{[1][14][]14}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.1}{\ignorespaces \textbf  {Paired differences from SEGA (released).} No per-band law improves on SEGA (released){} in any reward or image-quality metric, and DyPE's isolated gains in crop MUSIQ and CLIP-IQA come with losses elsewhere. The dashed blue line is SEGA (released); marks show held-out paired differences with 95\% bootstrap intervals (rows 8--194, seed 0, $n=187$), pale where the interval includes 0, and \cref  {tab:main} lists them. Hollow marks: seed-1 replication on rows 8--62 ($n=55$) for SEGA base\,+\,temp.\spacefactor \@m {}{} and Constancy-TM{} (none for SEGA\,+\,TM); triangles: NTK{} beyond the axis limit; arrows: better direction.\relax }}{14}{figure.caption.40}\protected@file@percent }
\newlabel{fig:forest}{{A.1}{14}{\textbf {Paired differences from \segaofficial .} No per-band law improves on \segaofficial {} in any reward or image-quality metric, and \dype 's isolated gains in crop MUSIQ and CLIP-IQA come with losses elsewhere. The dashed blue line is \segaofficial ; marks show held-out paired differences with 95\% bootstrap intervals (rows 8--194, seed 0, $n=\N {ho@nprompts}$), pale where the interval includes 0, and \cref {tab:main} lists them. Hollow marks: seed-1 replication on rows 8--62 ($n=\N {so@n@tsb}$) for \tempsb {} and \constancytm {} (none for \segactm ); triangles: \ntk {} beyond the axis limit; arrows: better direction.\relax }{figure.caption.40}{}}
\newlabel{fig:forest@cref}{{[figure][1][2147483647,1]A.1}{[1][14][]14}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.2}{\ignorespaces \textbf  {Native crops show what thumbnails hide.} Held-out rows 8, 9 and 10 (left to right), the first three held-out prompts, were fixed before any output was viewed; seed 0, each Lanczos-reduced full frame beside its unaltered 384-pixel crop (red box). During review, we chose one shared crop location per row on a fixed grid by maximizing the minimum Laplacian energy across all six arms, each normalized by its 90th percentile over candidate locations. This output-dependent rule favors detail present in every arm and selects no winning method; differing compositions remain a limitation. Full prompts are in \cref  {fig:qual}.\relax }}{15}{figure.caption.41}\protected@file@percent }
\newlabel{fig:qual_main}{{A.2}{15}{\textbf {Native crops show what thumbnails hide.} Held-out rows 8, 9 and 10 (left to right), the first three held-out prompts, were fixed before any output was viewed; seed 0, each Lanczos-reduced full frame beside its unaltered 384-pixel crop (red box). During review, we chose one shared crop location per row on a fixed grid by maximizing the minimum Laplacian energy across all six arms, each normalized by its 90th percentile over candidate locations. This output-dependent rule favors detail present in every arm and selects no winning method; differing compositions remain a limitation. Full prompts are in \cref {fig:qual}.\relax }{figure.caption.41}{}}
\newlabel{fig:qual_main@cref}{{[figure][2][2147483647,1]A.2}{[1][14][]15}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.3}{\ignorespaces \textbf  {Spectra against references and SEGA.} Without SEGA's per-band allocation, luminance power at 8 to 32 pixel wavelengths (gray band) sits above released SEGA's; Constancy-TM{} leaves a similar excess, and NTK{} falls short from 8 to 1024 pixels. (a)\nobreakspace  {}Log-power error against the mean $\qopname  \relax o{ln}P$ of the 195 Aesthetic-4K{} references, per octave band of linear-sRGB luminance; (b)\nobreakspace  {}paired difference from SEGA (released), the dashed blue zero line; positive means more power. Held-out rows 8--194 ($n=187$, seed 0) with 95\% bootstrap intervals over prompts; the dashed vertical marks the Nyquist frequency of a 224-pixel view.\relax }}{15}{figure.caption.42}\protected@file@percent }
\newlabel{fig:spectrum}{{A.3}{15}{\textbf {Spectra against references and \sega .} Without \sega 's per-band allocation, luminance power at 8 to 32 pixel wavelengths (gray band) sits above released \sega 's; \constancytm {} leaves a similar excess, and \ntk {} falls short from 8 to 1024 pixels. (a)~Log-power error against the mean $\ln P$ of the 195 \afk {} references, per octave band of linear-sRGB luminance; (b)~paired difference from \segaofficial , the dashed blue zero line; positive means more power. Held-out rows 8--194 ($n=\N {ho@nprompts}$, seed 0) with 95\% bootstrap intervals over prompts; the dashed vertical marks the Nyquist frequency of a 224-pixel view.\relax }{figure.caption.42}{}}
\newlabel{fig:spectrum@cref}{{[figure][3][2147483647,1]A.3}{[1][15][]15}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.4}{\ignorespaces \textbf  {NTK{} loses fine detail at $4096^2$.} The other arms render comparable detail, and DyPE{} shows faint speckle in flat sky on held-out row 8 (one crop checked); compositions differ between arms, so a crop can show different content. Held-out rows 8, 9 and 10 (left to right), the first three held-out rows, were fixed before any output was viewed; seed 0, one sample per arm. Full frames are Lanczos-reduced; native-resolution crops sit at identical coordinates and are never resampled (red: highest-detail tile of the across-arm mean luminance; cyan: image center). Prompts, left to right: ``A stone bridge with arched spans reflects golden light on the water, flanked by buildings and a leafy tree under a clear blue sky.'' ``A panoramic view of Paris featuring the Eiffel Tower, the Seine River, and various ornate buildings with greenery and bustling activity, including boats on the water and crowds along walkways.'' ``A cluttered artist's corner features an ornate gold frame, a painting of a man with glasses, several empty picture frames, a vintage suitcase, and various brushes in a tin can, all set against a textured gray wall and draped with patterned fabric.''\relax }}{16}{figure.caption.43}\protected@file@percent }
\newlabel{fig:qual}{{A.4}{16}{\textbf {\ntk {} loses fine detail at $4096^2$.} The other arms render comparable detail, and \dype {} shows faint speckle in flat sky on held-out row 8 (one crop checked); compositions differ between arms, so a crop can show different content. Held-out rows 8, 9 and 10 (left to right), the first three held-out rows, were fixed before any output was viewed; seed 0, one sample per arm. Full frames are Lanczos-reduced; native-resolution crops sit at identical coordinates and are never resampled (red: highest-detail tile of the across-arm mean luminance; cyan: image center). Prompts, left to right: ``A stone bridge with arched spans reflects golden light on the water, flanked by buildings and a leafy tree under a clear blue sky.'' ``A panoramic view of Paris featuring the Eiffel Tower, the Seine River, and various ornate buildings with greenery and bustling activity, including boats on the water and crowds along walkways.'' ``A cluttered artist's corner features an ornate gold frame, a painting of a man with glasses, several empty picture frames, a vintage suitcase, and various brushes in a tin can, all set against a textured gray wall and draped with patterned fabric.''\relax }{figure.caption.43}{}}
\newlabel{fig:qual@cref}{{[figure][4][2147483647,1]A.4}{[1][15][]16}}
\@writefile{lot}{\contentsline {table}{\numberline {A.1}{\ignorespaces \textbf  {Printed-law scores in the dev pilot.} CLIP score and ImageReward means over the eight dev prompts (rows 0--7, seed 0), with paired differences from SEGA (released){} and 95\% bootstrap intervals (2,000 resamples); descriptive only. Static variants freeze the allocation instead of reading the current latent. \Cref  {tab:pilot} gives the other metrics. Key result: freezing the printed allocation collapses both scores, while freezing the released allocation costs far less.\relax }}{16}{table.caption.44}\protected@file@percent }
\newlabel{tab:papercode_scores}{{A.1}{16}{\textbf {Printed-law scores in the dev pilot.} CLIP score and ImageReward means over the eight dev prompts (rows 0--7, seed 0), with paired differences from \segaofficial {} and 95\% bootstrap intervals (2,000 resamples); descriptive only. Static variants freeze the allocation instead of reading the current latent. \Cref {tab:pilot} gives the other metrics. Key result: freezing the printed allocation collapses both scores, while freezing the released allocation costs far less.\relax }{table.caption.44}{}}
\newlabel{tab:papercode_scores@cref}{{[table][1][2147483647,1]A.1}{[1][16][]16}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.5}{\ignorespaces \textbf  {Printed equations against the release.} The printed-law implementation produces larger gain changes than the release and degrades this development pilot. Eight dev prompts (rows 0--7, seed 0), descriptive only. (a)\nobreakspace  {}Median log logit gain per rotary pair (pair 0 has the highest frequency) and denoising step. Released and printed-law heatmaps have separate symmetric color scales, so equal colors across the groups do not mean equal magnitudes. The line panel uses one shared axis for mean log gain over prompts, steps and both spatial axes; static variants (dashed) average each method's gains over prompts and steps. (b)\nobreakspace  {}Dev prompt 0, seed 0: full frames and a native-resolution crop (red box). \Cref  {tab:papercode_scores} gives CLIP score and ImageReward means over the eight dev prompts, with paired differences from SEGA (released){} and 95\% bootstrap intervals.\relax }}{17}{figure.caption.45}\protected@file@percent }
\newlabel{fig:papercode}{{A.5}{17}{\textbf {Printed equations against the release.} The printed-law implementation produces larger gain changes than the release and degrades this development pilot. Eight dev prompts (rows 0--7, seed 0), descriptive only. (a)~Median log logit gain per rotary pair (pair 0 has the highest frequency) and denoising step. Released and printed-law heatmaps have separate symmetric color scales, so equal colors across the groups do not mean equal magnitudes. The line panel uses one shared axis for mean log gain over prompts, steps and both spatial axes; static variants (dashed) average each method's gains over prompts and steps. (b)~Dev prompt 0, seed 0: full frames and a native-resolution crop (red box). \Cref {tab:papercode_scores} gives CLIP score and ImageReward means over the eight dev prompts, with paired differences from \segaofficial {} and 95\% bootstrap intervals.\relax }{figure.caption.45}{}}
\newlabel{fig:papercode@cref}{{[figure][5][2147483647,1]A.5}{[1][16][]17}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.6}{\ignorespaces \textbf  {Lattice and checkpoint check.} The development comparison shows a lattice on FLUX.1-dev{}, but checkpoint and guidance both change. (a)\nobreakspace  {}Dev prompt 0 under official DyPE{} code (seed 42) and our DyPE{} and SEGA (released){} pipelines (seed 0), at guidance 3.5 (FLUX.1-dev) and 4.5 (FLUX.1-Krea-dev). Red and cyan boxes mark native 192-pixel windows at the same place in every image. (b)\nobreakspace  {}Whitened radial power spectra of luminance: FLUX.1-dev{} (black) peaks at the lattice period (dot) and FLUX.1-Krea-dev{} (gray) does not in these samples. Peak ratios: 36$\times $ for the official-code pair; over eight prompts in our pipeline, 12$\times $ [7, 20] for DyPE{} and 5$\times $ [2, 11] for SEGA (released){} (geometric means, 95\% bootstrap intervals). This figure alone does not isolate the checkpoint; the matched-guidance control of \cref  {tab:strengthen-ckpt} does.\relax }}{18}{figure.caption.46}\protected@file@percent }
\newlabel{fig:checkpoint}{{A.6}{18}{\textbf {Lattice and checkpoint check.} The development comparison shows a lattice on \fluxdev {}, but checkpoint and guidance both change. (a)~Dev prompt 0 under official \dype {} code (seed 42) and our \dype {} and \segaofficial {} pipelines (seed 0), at guidance 3.5 (\fluxdev ) and 4.5 (\krea ). Red and cyan boxes mark native 192-pixel windows at the same place in every image. (b)~Whitened radial power spectra of luminance: \fluxdev {} (black) peaks at the lattice period (dot) and \krea {} (gray) does not in these samples. Peak ratios: 36$\times $ for the official-code pair; over eight prompts in our pipeline, 12$\times $ [7, 20] for \dype {} and 5$\times $ [2, 11] for \segaofficial {} (geometric means, 95\% bootstrap intervals). This figure alone does not isolate the checkpoint; the matched-guidance control of \cref {tab:strengthen-ckpt} does.\relax }{figure.caption.46}{}}
\newlabel{fig:checkpoint@cref}{{[figure][6][2147483647,1]A.6}{[1][17][]18}}
