\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Per-band allocation ablation.} Paired held-out differences from SEGA base\,+\,temp.\spacefactor \@m {}{} ($n=187$, seed 0) after adding SEGA's allocation (shaded, the released default), the time-matched correction or both; triangles as in \cref  {tab:results}, unadjusted. \Cref  {tab:means_full} gives all ten metrics. Key result: only SEGA's allocation raises full-frame MUSIQ without a crop MUSIQ loss.\relax }}{7}{table.caption.25}\protected@file@percent }
\newlabel{tab:alloc}{{5}{7}{\textbf {Per-band allocation ablation.} Paired held-out differences from \tempsb {} ($n=\N {ho@nprompts}$, seed 0) after adding \sega 's allocation (shaded, the released default), the time-matched correction or both; triangles as in \cref {tab:results}, unadjusted. \Cref {tab:means_full} gives all ten metrics. Key result: only \sega 's allocation raises full-frame MUSIQ without a crop MUSIQ loss.\relax }{table.caption.25}{}}
