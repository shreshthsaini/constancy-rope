\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Temperature sweep.} Means of SEGA base\,+\,temp.\spacefactor \@m {}{} at five multipliers fixed in advance (rows 8--62, $n=55$, seed 0); shaded is SEGA's $s^{0.16}$. Triangles mark paired 95\% intervals against it that exclude zero, $^{*}$ a Holm-adjusted $p\le 0.05$ over 40 tests; \cref  {tab:strengthen-sweep} expands the table. Key result: no multiplier beats $s^{0.16}$ on a reward model or full-frame MUSIQ, while crop MUSIQ and CLIP-IQA rise at every step.\relax }}{7}{table.caption.25}\protected@file@percent }
\newlabel{tab:sweep_small}{{4}{7}{\textbf {Temperature sweep.} Means of \tempsb {} at five multipliers fixed in advance (rows 8--62, $n=\N {st@s@n}$, seed 0); shaded is \sega 's $s^{0.16}$. Triangles mark paired 95\% intervals against it that exclude zero, $^{*}$ a Holm-adjusted $p\le 0.05$ over 40 tests; \cref {tab:strengthen-sweep} expands the table. Key result: no multiplier beats $s^{0.16}$ on a reward model or full-frame MUSIQ, while crop MUSIQ and CLIP-IQA rise at every step.\relax }{table.caption.25}{}}
